<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>false</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <NoStdLib>true</NoStdLib>
    <NoConfig>true</NoConfig>
    <RuntimeMetadataVersion>v4.0.30319</RuntimeMetadataVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <DisableImplicitUsings>true</DisableImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <DefineConstants>$(DefineConstants);TARGET_64BIT</DefineConstants>
    <AssemblyName>osbkt</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- mini-CoreLib sources: link the canonical copies from osb.core
         (sibling checkout, see README.md "Sibling checkouts"). osb.core keeps
         the library in several src/*.cs files, so the whole directory is
         linked (MiniCoreLib.cs alone no longer defines the primitives). -->
    <Compile Include="../osb.core/src/*.cs" Link="osb.core/%(Filename)%(Extension)" />
    <Compile Include="Syscall.cs" />
    <Compile Include="Syscall.Raw.cs" />
    <Compile Include="Syscall.Ipc.cs" />
    <Reference Include="System.Runtime.InteropServices" />
  </ItemGroup>

  <!-- Fail with a clear message when a sibling repo is missing (A10). -->
  <Target Name="CheckSiblings" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)../osb.core/src/MiniCoreLib.cs')"
           Text="osb.core sibling repo not found (expected ../osb.core/src/MiniCoreLib.cs). Clone the OSB repos side by side; see README.md." />
  </Target>

  <!-- Same as kernel: strip out unnecessary .NET references -->
  <Target Name="CustomizeReferences" BeforeTargets="BeforeCompile" AfterTargets="FindReferenceAssembliesForReferences">
    <ItemGroup>
      <ReferencePathWithRefAssemblies Remove="@(ReferencePathWithRefAssemblies)" />
      <ReferencePath Remove="@(ReferencePath)" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveHostConfigurationOptions" BeforeTargets="WriteIlcRspFileForCompilation" DependsOnTargets="PrepareForILLink">
    <ItemGroup>
      <RuntimeHostConfigurationOption Remove="@(RuntimeHostConfigurationOption)" />
    </ItemGroup>
  </Target>
</Project>